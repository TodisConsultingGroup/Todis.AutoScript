<Window x:Class="Todis.AutoScript.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todis AutoScript" Height="760" Width="1100" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Połączenie" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Ustawienia zapisują się lokalnie na tym komputerze." Foreground="#6B7280" Margin="0,4,0,18" TextWrapping="Wrap"/>
                    <TextBlock Text="Serwer / instancja"/><TextBox x:Name="ServerTextBox" ToolTip="np. localhost\SQLEXPRESS"/>
                    <TextBlock Text="Nazwa bazy"/><TextBox x:Name="DatabaseTextBox"/>
                    <TextBlock Text="Uwierzytelnianie"/>
                    <ComboBox x:Name="AuthenticationComboBox" SelectionChanged="AuthenticationChanged">
                        <ComboBoxItem Content="Windows" Tag="Windows"/>
                        <ComboBoxItem Content="SQL Server" Tag="Sql"/>
                    </ComboBox>
                    <StackPanel x:Name="SqlCredentialsPanel">
                        <TextBlock Text="Login"/><TextBox x:Name="UserNameTextBox"/>
                        <TextBlock Text="Hasło"/><PasswordBox x:Name="PasswordInput"/>
                    </StackPanel>
                    <CheckBox x:Name="TrustCertificateCheckBox" Content="Ufaj certyfikatowi serwera" Margin="0,6,0,14"/>
                    <WrapPanel>
                        <Button Content="Zapisz ustawienia" Click="SaveSettingsClick" Background="#E5E7EB"/>
                        <Button Content="Testuj połączenie" Click="TestConnectionClick"/>
                    </WrapPanel>
                    <Separator Margin="0,18"/>
                    <TextBlock Text="Źródło skryptów" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Folder główny" Margin="0,12,0,0"/><TextBox x:Name="ScriptsRootTextBox" IsReadOnly="True"/>
                    <Button Content="Zmień folder główny…" Click="ChooseRootClick" HorizontalAlignment="Left"/>
                    <TextBlock Text="Zestaw skryptów / typ bazy" Margin="0,12,0,0"/>
                    <ComboBox x:Name="ScriptFolderComboBox" SelectionChanged="ScriptFolderChanged"/>
                    <Button Content="Odśwież foldery" Click="RefreshFoldersClick" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Kolejka skryptów" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Text="Wybierz zestaw skryptów." Foreground="#6B7280" Margin="0,4,0,15"/>
                    </StackPanel>
                    <Button x:Name="RunButton" Content="▶  Uruchom skrypty" Click="RunScriptsClick" Background="#2563EB" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </DockPanel>
                <ProgressBar x:Name="RunProgress" Grid.Row="1" Height="8" Minimum="0" Margin="0,0,0,16"/>
                <DataGrid x:Name="ScriptsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}" Width="38"/>
                        <DataGridTextColumn Header="Plik" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Szczegóły" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="Log" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,5"/>
                <TextBox x:Name="LogTextBox" Grid.Row="4" Height="125" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#E5E7EB"/>
            </Grid>
        </Border>
    </Grid>
</Window>
