<Window x:Class="Todis.AutoScript.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Todis.AutoScript.Converters"
        Title="Todis AutoScript" Height="840" Width="1100" MinHeight="720" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <converters:RowNumberConverter x:Key="RowNumberConverter"/>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Połączenie" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right" Width="42" Height="38" Padding="0" Margin="8,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="18" Click="ToggleThemeClick" Content="&#xE708;" ToolTip="Włącz ciemny motyw"/>
                    </DockPanel>
                    <TextBlock Text="Ustawienia zapisują się lokalnie na tym komputerze." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18" TextWrapping="Wrap"/>
                    <TextBlock Text="Serwer / instancja"/><TextBox x:Name="ServerTextBox" ToolTip="np. localhost\SQLEXPRESS"/>
                    <TextBlock Text="Nazwa bazy"/><TextBox x:Name="DatabaseTextBox"/>
                    <TextBlock Text="Uwierzytelnianie"/>
                    <ComboBox x:Name="AuthenticationComboBox" SelectionChanged="AuthenticationChanged">
                        <ComboBoxItem Content="Windows" Tag="Windows"/>
                        <ComboBoxItem Content="SQL Server" Tag="Sql"/>
                    </ComboBox>
                    <StackPanel x:Name="SqlCredentialsPanel">
                        <TextBlock Text="Login"/><TextBox x:Name="UserNameTextBox"/>
                        <TextBlock Text="Hasło"/><PasswordBox x:Name="PasswordInput"/>
                    </StackPanel>
                    <CheckBox x:Name="TrustCertificateCheckBox" Content="Ufaj certyfikatowi serwera" Margin="0,6,0,14"/>
                    <WrapPanel>
                        <Button Content="Zapisz ustawienia" Click="SaveSettingsClick"/>
                        <Button Content="Testuj połączenie" Click="TestConnectionClick"/>
                    </WrapPanel>
                    <Separator Margin="0,18"/>
                    <TextBlock Text="Źródło skryptów" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Folder główny" Margin="0,12,0,0"/><TextBox x:Name="ScriptsRootTextBox" IsReadOnly="True"/>
                    <Button Content="Zmień folder główny…" Click="ChooseRootClick" HorizontalAlignment="Left"/>
                    <TextBlock Text="Zestaw skryptów / typ bazy" Margin="0,12,0,0"/>
                    <ComboBox x:Name="ScriptFolderComboBox" SelectionChanged="ScriptFolderChanged"/>
                    <Button Content="Odśwież foldery" Click="RefreshFoldersClick" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="SingleTransactionCheckBox" Content="Uruchom cały zestaw w jednej transakcji" Margin="0,14,0,4" Checked="TransactionModeChanged" Unchecked="TransactionModeChanged" ToolTip="Po błędzie wycofuje zmiany wszystkich skryptów z bieżącego uruchomienia"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Kolejka skryptów" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryText" Text="Wybierz zestaw skryptów." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,15"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="RunButton" Content="▶  Uruchom wszystkie" Click="RunScriptsClick" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="ResumeButton" Content="↪  Wznów od zaznaczonego" Click="ResumeScriptsClick" IsEnabled="False" ToolTip="Dostępne tylko w trybie osobnych transakcji"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="RunProgress" Grid.Row="1" Height="8" Minimum="0" Margin="0,0,0,16"/>
                <DataGrid x:Name="ScriptsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ScriptsGridSelectionChanged" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource RowNumberConverter}}" Width="38"/>
                        <DataGridTextColumn Header="Plik" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Szczegóły" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="Log" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,5"/>
                <TextBox x:Name="LogTextBox" Grid.Row="4" Height="125" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{DynamicResource LogBackgroundBrush}" Foreground="{DynamicResource LogTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
